# ============================================================================
# 亿网通IT运维监控管理平台 —— Git 忽略规则
# 目标：公开仓库只提交源码与配置模板，绝不提交密钥/数据库/日志/私有记忆
# ============================================================================

# ---------- 密钥与本地配置（含 SECRET_KEY / FERNET_KEY 等敏感信息）----------
.env

# ---------- 运行时数据（SQLite 数据库及自动备份）----------
data/

# ---------- 运行/访问日志 ----------
logs/

# ---------- Python 缓存与测试产物 ----------
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ---------- 项目私有记忆（非交付内容）----------
.workbuddy/

# ---------- 系统/编辑器元数据 ----------
.DS_Store
.idea/
.vscode/
