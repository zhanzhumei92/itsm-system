# ============================================================================
# 亿网通IT运维监控管理平台 —— 环境变量示例
# 使用方式：复制为 .env 后按现场实际情况修改
#   cp .env.example .env
# 注意：.env 含敏感密钥，禁止提交到版本库
# ============================================================================

# ---------- 应用基础 ----------
APP_NAME=亿网通IT运维监控管理平台
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
# 演示环境用 1 可自动生成 8 台虚拟设备与历史指标，便于大屏出效果
DEMO_MODE=false

# ---------- 数据库 ----------
# SQLite（初期，默认）：相对路径基准为项目根目录
DATABASE_URL=sqlite:///./data/itsm.db
# MySQL（设备超 500 台或采集周期 < 30 秒时切换，业务代码零改动）：
# DATABASE_URL=mysql+pymysql://itsm:密码@127.0.0.1:3306/itsm?charset=utf8mb4

# ---------- 安全密钥（生产环境必须重新生成！）----------
# SECRET_KEY：JWT 签名密钥  → python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=AMT6hUDAE-wZe_MLt6UCE3p23-Thl7B2LRTz2HkawaP9_jO8W3oul8VIVM1J8rO-
# FERNET_KEY：设备口令 / 告警密钥的对称加密密钥
# 生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# 警告：此密钥一旦更换，已加密入库的设备口令将无法解密，需重新录入
FERNET_KEY=RVTxuDgMC07w4gHhgV6vCl38m_rzTbkwsHH7O8vMXlE=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------- 日志 ----------
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_KEEP_DAYS=30

# ---------- 调度与采集 ----------
SCHEDULER_ENABLED=true
COLLECT_THREAD_POOL_SIZE=60
COLLECT_DEFAULT_INTERVAL=60
COLLECT_DEFAULT_TIMEOUT=10

# ---------- 跨域（大屏单独部署时按需收紧）----------
CORS_ORIGINS=*
